{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bandi.local/contracts/backup-local.schema.json",
  "title": "Bandi Local Backup",
  "type": "object",
  "additionalProperties": false,
  "required": ["createRequest", "snapshot", "previewRequest", "restorePreview", "restoreRequest", "restoreResult"],
  "properties": {
    "createRequest": { "$ref": "#/$defs/createRequest" },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "previewRequest": { "$ref": "#/$defs/previewRequest" },
    "restorePreview": { "$ref": "#/$defs/restorePreview" },
    "restoreRequest": { "$ref": "#/$defs/restoreRequest" },
    "restoreResult": { "$ref": "#/$defs/restoreResult" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootKind", "displayPath"],
      "properties": {
        "rootKind": { "enum": ["managed", "bandi"] },
        "displayPath": { "type": "string", "minLength": 1, "maxLength": 512 },
        "relativePath": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assetId", "containerId", "assetContentHash", "containerContentHash"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "assetId": { "$ref": "#/$defs/id" },
        "containerId": { "$ref": "#/$defs/id" },
        "assetContentHash": { "$ref": "#/$defs/hash" },
        "containerContentHash": { "$ref": "#/$defs/hash" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "severity": { "enum": ["error", "warning", "info"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "field": { "type": "string", "maxLength": 128 },
        "remediation": { "type": "string", "maxLength": 16384 }
      }
    },
    "createRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "scope"],
      "properties": {
        "requestId": { "$ref": "#/$defs/id" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "assetIds"],
          "properties": {
            "kind": { "const": "files" },
            "assetIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    },
    "snapshotEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "containerId", "kind", "locator", "assetContentHash", "containerContentHash", "snapshotContentHash", "sizeBytes", "redacted"],
      "properties": {
        "assetId": { "$ref": "#/$defs/id" },
        "containerId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["instructions", "context", "rules", "skills", "mcp", "permissions", "sop", "hooks", "commands"] },
        "locator": { "$ref": "#/$defs/locator" },
        "assetContentHash": { "$ref": "#/$defs/hash" },
        "containerContentHash": { "$ref": "#/$defs/hash" },
        "snapshotContentHash": { "$ref": "#/$defs/hash" },
        "sizeBytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "redacted": { "const": false }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "scope", "createdAt", "entryCount", "manifestHash", "integrity", "entries"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["manual", "pre_restore"] },
        "scope": { "const": "files" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "entryCount": { "type": "integer", "minimum": 1, "maximum": 256 },
        "manifestHash": { "$ref": "#/$defs/hash" },
        "integrity": { "enum": ["verified", "failed"] },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/snapshotEntry" }
        }
      }
    },
    "previewEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "status", "snapshotContentHash"],
      "properties": {
        "assetId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["ready", "baseline_changed", "missing_current", "integrity_failed", "unavailable"] },
        "snapshotContentHash": { "$ref": "#/$defs/hash" },
        "currentBaseline": { "$ref": "#/$defs/baseline" },
        "diagnostics": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "previewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "snapshotId", "assetIds"],
      "properties": {
        "requestId": { "$ref": "#/$defs/id" },
        "snapshotId": { "$ref": "#/$defs/id" },
        "assetIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "restorePreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "previewRef", "snapshotId", "expiresAt", "entries", "canRestore", "requiresConfirmation"],
      "properties": {
        "requestId": { "$ref": "#/$defs/id" },
        "previewRef": { "$ref": "#/$defs/id" },
        "snapshotId": { "$ref": "#/$defs/id" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/previewEntry" }
        },
        "canRestore": { "type": "boolean" },
        "requiresConfirmation": { "const": true }
      }
    },
    "restoreRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "snapshotId", "assetIds", "previewRef", "confirmed"],
      "properties": {
        "requestId": { "$ref": "#/$defs/id" },
        "snapshotId": { "$ref": "#/$defs/id" },
        "assetIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "previewRef": { "$ref": "#/$defs/id" },
        "confirmed": { "const": true }
      }
    },
    "restoreEntryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "status"],
      "properties": {
        "assetId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["restored", "baseline_changed", "integrity_failed", "validation_failed", "save_failed", "skipped"] },
        "revisionId": { "$ref": "#/$defs/id" },
        "retryable": { "type": "boolean" },
        "fileState": { "enum": ["unchanged", "write_not_verified", "verified_written_revision_pending"] },
        "recoveryRef": { "$ref": "#/$defs/id" },
        "diagnostics": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "restoreResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requestId", "snapshotId", "preRestoreSnapshotId", "entries"],
      "properties": {
        "kind": { "enum": ["restored", "partial_failure", "restore_failed"] },
        "requestId": { "$ref": "#/$defs/id" },
        "snapshotId": { "$ref": "#/$defs/id" },
        "preRestoreSnapshotId": { "$ref": "#/$defs/id" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/restoreEntryResult" }
        }
      }
    }
  }
}
