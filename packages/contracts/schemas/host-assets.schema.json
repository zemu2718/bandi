{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bandi.local/schemas/host-assets.schema.json",
  "title": "Bandi Host Assets",
  "oneOf": [
    { "$ref": "#/$defs/catalog" },
    { "$ref": "#/$defs/scanRequest" },
    { "$ref": "#/$defs/detailRequest" },
    { "$ref": "#/$defs/previewRequest" },
    { "$ref": "#/$defs/commitRequest" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
    "toolId": { "enum": ["claude-code", "claude-desktop", "codex", "gemini-cli", "grok-build", "opencode", "openclaw", "hermes", "pi"] },
    "packageLimits": {
      "const": { "maxDepth": 12, "maxFiles": 512, "maxFileBytes": 10485760, "maxTotalBytes": 52428800, "skillEntrypointBytes": 262144 }
    },
    "packageFile": {
      "type": "object", "additionalProperties": false, "required": ["path", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024, "not": { "pattern": "(^/|\\\\|(^|/)\\.\\.?(/|$)|[\\u0000-\\u001F\\u007F])" } },
        "bytes": { "type": "array", "maxItems": 10485760, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canScan", "canReadEntrypoint", "canImportToBandi", "canInstallFromBandi", "canUpdateFromBandi"],
      "properties": {
        "canScan": { "type": "boolean" }, "canReadEntrypoint": { "type": "boolean" },
        "canImportToBandi": { "type": "boolean" }, "canInstallFromBandi": { "type": "boolean" },
        "canUpdateFromBandi": { "type": "boolean" }
      }
    },
    "catalogEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["toolId", "supportLevel", "capabilities", "reasonCode"],
      "properties": {
        "toolId": { "$ref": "#/$defs/toolId" },
        "supportLevel": { "enum": ["supported", "degraded", "unsupported"] },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "reasonCode": { "type": "string", "minLength": 1 }
      }
    },
    "catalog": {
      "type": "object", "additionalProperties": false, "required": ["tools"],
      "properties": { "tools": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/catalogEntry" } } }
    },
    "scanRequest": {
      "type": "object", "additionalProperties": false, "required": ["requestId", "toolIds"],
      "properties": { "requestId": { "$ref": "#/$defs/id" }, "toolIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/toolId" } } }
    },
    "detailRequest": {
      "type": "object", "additionalProperties": false, "required": ["requestId", "hostInstanceId", "scanGeneration"],
      "properties": { "requestId": { "$ref": "#/$defs/id" }, "hostInstanceId": { "$ref": "#/$defs/id" }, "scanGeneration": { "$ref": "#/$defs/id" } }
    },
    "previewRequest": {
      "type": "object", "additionalProperties": false, "required": ["requestId", "hostInstanceId", "scanGeneration", "action", "teamId", "assetId"],
      "properties": {
        "requestId": { "$ref": "#/$defs/id" }, "hostInstanceId": { "$ref": "#/$defs/id" }, "scanGeneration": { "$ref": "#/$defs/id" },
        "action": { "const": "import" }, "teamId": { "$ref": "#/$defs/id" }, "assetId": { "$ref": "#/$defs/id" }
      }
    },
    "commitRequest": {
      "type": "object", "additionalProperties": false, "required": ["requestId", "action", "previewRef", "sourceFingerprint", "confirmed"],
      "properties": {
        "requestId": { "$ref": "#/$defs/id" }, "action": { "const": "import" },
        "previewRef": { "$ref": "#/$defs/id" }, "sourceFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "confirmed": { "const": true }
      }
    }
  }
}
